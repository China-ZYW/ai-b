# ============================================================================
# aibi 本地/生产凭据模板（安存治理 T1）
# 复制本文件为 backend/local.env（本地）或 /opt/aibi/aibi.env（生产 systemd），
# 填入真实值。local.env 已 gitignore，绝不入库。
# 生产用法：aibi.service 增加  EnvironmentFile=/opt/aibi/aibi.env（权限 600）
# ============================================================================

# ── 平台元数据库（必填，缺失启动即失败）──────────────────────────────
AIBI_DB_URL=jdbc:mysql://<HOST>:3306/aibi_meta?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
AIBI_DB_USERNAME=<META_DB_USER>
AIBI_DB_PASSWORD=<META_DB_PASSWORD>

# ── JWT 签名密钥（必填，≥32 字节强随机；轮换会使全部在线会话失效）──────
JWT_SECRET=<RANDOM_32PLUS_BYTES>

# ── 数据源凭证 AES-GCM 主密钥（必填；轮换前必须先完成存量密文双 key 重加密）──
AIBI_CIPHER_KEY=<STABLE_SECRET_KEEP_AFTER_FIRST_BOOT>

# ── LLM（问数必需；不填则 DeepSeek 不可用，LlmRouter 自动尝试 Qwen 备选）──
DEEPSEEK_API_KEY=<DEEPSEEK_KEY>
# QWEN_API_KEY=<QWEN_KEY_OPTIONAL>

# ── 平台超管首次播种口令（仅空库首启生效；生产建议注入强口令）───────────
AIBI_SUPERADMIN_PASSWORD=<SUPERADMIN_PASSWORD>

# ── 可选覆盖项（默认值见 application.yml 注释）───────────────────────
# AIBI_SHARE_BASE_URL=https://your-domain
# AIBI_MCP_RESOURCE_URL=https://your-domain/mcp
# AIBI_MAIL_ENABLED=true
# AIBI_MAIL_HOST=smtp.example.com
# AIBI_MAIL_USERNAME=noreply@example.com
# AIBI_MAIL_PASSWORD=<SMTP_AUTH_CODE>
# AIBI_MAIL_FROM=noreply@example.com
# AIBI_UPLOAD_DIR=/var/lib/aibi/uploads
# AIBI_MCP_ENABLED=true
# AIBI_SECRETS_VALIDATE=false   # 仅排障时临时跳过凭据校验
