# =============================================================================
# aibi 前端环境变量模板（Vite 构建期/运行期注入）
#
# 用法：复制本文件为 frontend/.env.local （dev/build 均生效，gitignore 已排除）
#      或 frontend/.env.production（仅生产构建生效）
#      然后按部署实际填写。未列在这里的 VITE_* 若代码有读取，按需追加。
#
# 说明：.env.example 会被 git 跟踪，作为模板共享；.env / .env.local /
#      .env.production 等一律不入库（见仓库根 .gitignore）。
# =============================================================================

# ── 后端地址（vite dev 与 build 时期由 vite.config.ts 读取；未填默认 http://localhost:8080）──
# Windows 上开发强烈建议指向 127.0.0.1 而非 localhost，避免 IPv6 ::1 兜底导致 /api 500 空响应。
VITE_BACKEND=http://127.0.0.1:8080

# ── ICP 备案条（可选，中国大陆公开部署须填；不填则前端底部条不渲染）──────────
# 由 src/components/common/IcpFooter.vue 读取；见 docs/05-operations/本地启动与联调.md 第 7 节。
# VITE_ICP_COMPANY  ：备案主体名称（公司全称 / 个人站可写"个人"）
# VITE_ICP_NUMBER   ：ICP 备案号，例："蜀ICP备2026000000号-1"；点击自动跳 beian.miit.gov.cn
# 国内公开线上：两者至少填一个（推荐都填）；内网 / 海外部署：留空即可整条隐藏。
VITE_ICP_COMPANY=
VITE_ICP_NUMBER=

# ── 落地页 Demo 嵌入地址（可选，LandingTryStats.vue 读取；未填不显示"立即体验"iframe）──
VITE_DEMO_EMBED_URL=
