# =============================================================================
# aibi .gitignore
# 关键教训（T6 仓库卫生）：项目习惯用 `git add -A`，所以"未跟踪但未忽略"
# 的目录 = 潜在泄露。新增本地工具/凭据/日志目录时，**先加忽略再落盘**。
# 规则只对未跟踪文件生效；已 tracked 的文件需 `git rm --cached <path>` 才出库。
# =============================================================================

# ─── 凭据与环境变量（严格禁止入库）─────────────────────────────
# 本地开发凭据（由 backend/local.env.example 复制生成）
local.env
*.local.env
.env
.env.*
!.env.example
!local.env.example
*keys.env
*_secrets.env

# ─── 构建产物 ────────────────────────────────────────────────
# Java / Maven
target/
*.jar
*.war
*.class
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/target/

# Node / Vite
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ─── 日志与运行产物 ──────────────────────────────────────────
*.log
logs/
run.log
run.err.log
hs_err_pid*
replay_pid*
*.out
*_out.txt
mvn_*.txt
prod_*
stats.txt
smoke-result.tsv
scripts/smoke-result.tsv

# ─── 上传/落盘数据（默认相对路径 ./data 会随启动 cwd 漂移）─────
/data/uploads/
/data/materials/
backend/data/

# ─── IDE / 编辑器 ────────────────────────────────────────────
.idea/
*.iml
*.iws
.vscode/
!.vscode/extensions.json
!.vscode/settings.sample.json
.settings/
.project
.classpath
.factorypath
*.swp
*.swo
*~

# ─── 操作系统 ────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── 探针/临时目录 ───────────────────────────────────────────
.probe/
**/_archive/
backend/_*.py
backend/_*.txt

# ─── 测试与覆盖率 ────────────────────────────────────────────
coverage/
.nyc_output/
*.gcov
*.profdefault
jest-results.xml
test-results/
**/test-output/

# ─── Docker 卷与本地开发缓存 ────────────────────────────────
docker-data/
pgdata/
mysqldata/

# ─── 包管理器缓存 ────────────────────────────────────────────
.pnp
.pnp.js
.eslintcache
.stylelintcache

# ─── Python 缓存（demo/ 下预置数据生成脚本）────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# ─── 服务运行态 PID（init 脚本后台启动记录）───────────────
*.pid

# ─── CI 本地门禁的生成产物（写守卫审计报告等）────────────
.ci-artifacts/

# ─── 回滚备份产物（npm build 重命名旧 dist / jar 部署备份）────
frontend/dist_old_*/
frontend/dist_bak_*/
*.jar.bak.*
*.bak.*

# ─── backend 一次性日志与输出───────────────────────────
backend/mvn_*.log
backend/*.log
frontend/*.log
backend/verify_*.out
backend/zz_*.txt
_checklog.py
_ls.txt

